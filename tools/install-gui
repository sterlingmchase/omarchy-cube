#!/usr/bin/env bash
# Run manually after installing the native plugin. Placement args go to Omarchy.
set -euo pipefail
bridge_only=false
if [[ ${1:-} == --bridge-only ]]; then
  bridge_only=true
  shift
  [[ $# == 0 ]] || { echo 'Usage: tools/install-gui --bridge-only' >&2; exit 2; }
fi
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
config=${XDG_CONFIG_HOME:-$HOME/.config}
for command in omarchy-shell omarchy hyprctl python3 lua; do
  command -v "$command" >/dev/null || { echo "Required command missing: $command" >&2; exit 1; }
done
# A present CLI cannot install into a shell that is not running.
omarchy-shell shell ping >/dev/null
module="$config/hypr/cube.lua"
destination="$config/omarchy/plugins/local.cube"
[[ -f "$module" && -f "$HOME/.local/lib/hypr/omarchy-cube.so" ]] || {
  echo 'Install the native Omarchy Cube plugin first.' >&2; exit 1;
}
omarchy plugin validate "$root"
status=$(hyprctl omarchy-cube:status)
[[ "$status" == active=* ]] || { echo 'Native Omarchy Cube is not loaded.' >&2; exit 1; }
errors=$(hyprctl configerrors)
[[ -z "${errors//[[:space:]]/}" ]] || { printf '%s\n' "$errors" >&2; exit 1; }
prepared=$(mktemp "${module}.new.XXXXXX")
trap 'rm -f -- "$prepared"' EXIT
cp -p -- "$module" "$prepared"
python3 - "$module" "$root/shell/SettingsBridge.lua" "$prepared" <<'PYPREPARE'
import os
from pathlib import Path
import stat
import subprocess
import sys

module, bridge, prepared = map(Path, sys.argv[1:])
target = module.with_name("cube-gui.lua")
try:
    fd = os.open(target, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
except FileNotFoundError:
    pass
except OSError as error:
    sys.exit(f"Refusing occupied settings path {target}: {error}")
else:
    with os.fdopen(fd, "rb") as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            sys.exit(f"Refusing non-regular settings path {target}")
        data = stream.read(32769)
    if not 0 < len(data) <= 32768:
        sys.exit(f"Refusing invalid settings size at {target}")
    stub = (
        'local data = io.read("*a"); hl = {get_loaded_plugins=function() '
        'return {{name="Omarchy Cube"}} end, config=function() end, '
        'plugin={cube={read_settings=function() return data end}}}; dofile(arg[1]); os.exit(0)'
    )
    result = subprocess.run(["lua", "-E", "-e", stub, "--", "-",
                             str(bridge)], input=data, capture_output=True, timeout=5)
    if result.returncode:
        sys.exit(f"Refusing unrecognized settings at {target}")

current = module.read_text()
replacement = bridge.read_text().lstrip("\n")
legacy = """-- Omarchy Cube GUI bridge v1
-- Load GUI overrides only after the native plugin has registered its options.
for _, plugin in ipairs(hl.get_loaded_plugins()) do
  if plugin.name == "Omarchy Cube" then
    local directory = (os.getenv("XDG_CONFIG_HOME") or (os.getenv("HOME") .. "/.config")) .. "/hypr/"
    local file = io.open(directory .. "cube-gui.lua", "r")
    if file then
      file:close()
      hl.config({ plugin = { cube = dofile(directory .. "cube-gui.lua") } })
    end
    break
  end
end
"""
# The prior v2 parser has the same safe data-only format but no curvature key.
previous_v2 = replacement.replace("face_curvature = {-1, 1}, ", "", 1)
for known in (legacy, previous_v2, replacement):
    if current.count(known) == 1 and current.count("-- Omarchy Cube GUI bridge v") == 1:
        current = current.replace(known, replacement, 1)
        break
else:
    if "-- Omarchy Cube GUI bridge v" in current:
        sys.exit("Unrecognized cube.lua bridge. Back it up and remove the old bridge before reinstalling.")
    current += replacement if current.endswith("\n\n") else "\n" + replacement
prepared.write_text(current)
PYPREPARE
stamp=$(date +%Y%m%d-%H%M%S)-$$
backup="$module.gui-backup-$stamp"
cp -p -- "$module" "$backup"
# Any reload or validation failure restores the original Lua module.
restore() {
  cp -p -- "$backup" "$module"
  hyprctl reload >&2 || true
  hyprctl configerrors >&2 || true
  echo "Restored cube.lua from $backup" >&2
}
trap restore ERR
mv -f -- "$prepared" "$module"
hyprctl reload
errors=$(hyprctl configerrors)
if [[ -n "${errors//[[:space:]]/}" ]]; then
  printf '%s\n' "$errors" >&2
  false
fi
trap - ERR
if [[ $bridge_only == true ]]; then
  printf 'GUI settings bridge installed. Enable the marketplace widget when ready.\n'
  exit 0
fi
if [[ -d "$destination" ]]; then
  mkdir -p "$config/omarchy/plugin-backups"
  cp -a -- "$destination" "$config/omarchy/plugin-backups/local.cube-$stamp"
fi
mkdir -p "$destination/i18n"
install -m644 "$root"/shell/{Cube.qml,PlainText.qml,ValueRow.qml,control.py,SettingsBridge.lua} "$destination/"
install -m644 "$root/shell/i18n/en.json" "$destination/i18n/"
cp -a -- "$root/shell/assets" "$destination/"
python3 - "$root/manifest.json" "$destination/manifest.json" <<'PYMANIFEST'
import json, sys
from pathlib import Path
manifest = json.loads(Path(sys.argv[1]).read_text())
manifest["id"] = "local.cube"
manifest["entryPoints"]["barWidget"] = "Cube.qml"
Path(sys.argv[2]).write_text(json.dumps(manifest, indent=2) + "\n")
PYMANIFEST
omarchy plugin validate "$destination"
if [[ -f "$config/omarchy/shell.json" ]]; then
  cp -p -- "$config/omarchy/shell.json" "$config/omarchy/shell.json.cube-backup-$stamp"
fi
omarchy-shell shell rescanPlugins
found=false
for attempt in {1..30}; do
  if omarchy plugin list --json | python3 -c 'import json,sys; sys.exit(not any(p["id"] == "local.cube" for p in json.load(sys.stdin)))'; then
    found=true
    break
  fi
  sleep 0.1
done
[[ "$found" == true ]] || { echo 'Shell did not discover local.cube; try omarchy-shell shell rescanPlugins.' >&2; exit 1; }
omarchy plugin enable local.cube "$@"
printf 'Omarchy Cube controls installed. Click the cube icon in your bar.\n'
