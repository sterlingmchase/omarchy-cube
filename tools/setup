#!/usr/bin/env python3
"""Explicit, interactive first-run setup; never run by merely importing the widget."""
import datetime
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys

SUPPORTED_COMMIT = "efb50993780079460b0cbed1363e2166a2de1d9f"
ROOT = Path(__file__).resolve().parent.parent


def run(*args, capture=False):
    result = subprocess.run(args, check=True, text=True,
                            stdout=subprocess.PIPE if capture else None)
    return result.stdout.strip() if capture else None


def check_runtime():
    version = json.loads(run("hyprctl", "version", "-j", capture=True))
    if version.get("commit") != SUPPORTED_COMMIT:
        raise RuntimeError("This release requires Hyprland 0.56.2 (" + SUPPORTED_COMMIT +
                           "). Your compositor is not supported; nothing was changed.")
    errors = run("hyprctl", "configerrors", capture=True)
    if errors:
        raise RuntimeError("Fix existing Hyprland configuration errors first:\n" + errors)
    run("omarchy-shell", "shell", "ping", capture=True)


def main():
    if sys.argv[1:] not in ([], ["--check"]):
        raise RuntimeError("Usage: tools/setup [--check]")
    check_runtime()
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "hypr"
    main_config = config / "hyprland.lua"
    module = config / "cube.lua"
    library = Path.home() / ".local/lib/hypr/omarchy-cube.so"
    if not main_config.is_file() or main_config.is_symlink():
        raise RuntimeError("Expected a regular ~/.config/hypr/hyprland.lua; refusing to guess your config layout.")
    if module.exists() or module.is_symlink() or library.exists() or library.is_symlink():
        raise RuntimeError("An existing native Cube installation was found. It was left untouched. "
                           "Use the documented update procedure; first-run setup will not replace a loaded library or your settings.")
    if (config / "cube-gui.lua").exists() or (config / "cube-gui.lua").is_symlink():
        raise RuntimeError("Existing Cube settings found. Restore/update your existing installation instead.")
    original = main_config.read_bytes()
    if b"hypr.cube" in original:
        raise RuntimeError("Your config already references hypr.cube. Resolve the existing setup first.")
    if sys.argv[1:] == ["--check"]:
        print("Compatible compositor and clean first-run configuration.")
        return
    if not sys.stdin.isatty():
        raise RuntimeError("Run setup in a terminal so you can review and confirm the changes.")
    print("Omarchy Cube first-run setup\n\n"
          "This builds native code that runs INSIDE your compositor. Save your work first.\n"
          "It will install missing Arch build dependencies (sudo may ask for a password),\n"
          "build locally, add the default shortcuts, back up hyprland.lua, and load Cube.\n"
          "No prebuilt binaries are downloaded. Existing installations are never overwritten.\n")
    if input("Build and enable Omarchy Cube? [y/N] ").strip().lower() != "y":
        print("Cancelled. Nothing changed.")
        return
    dependencies = ["base-devel", "hyprland", "pixman", "libdrm", "cairo", "pango",
                    "lua", "libjpeg-turbo", "libglvnd", "zenity"]
    missing = [p for p in dependencies if subprocess.run(
        ["pacman", "-Q", p], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode]
    if missing:
        run("sudo", "pacman", "-S", "--needed", *missing)
    for command in ("make", "c++", "pkg-config", "lua", "omarchy"):
        if not shutil.which(command):
            raise RuntimeError("Required command missing: " + command)
    # Always rebuild against the installed headers; never trust a stale checkout binary.
    run("make", "-C", str(ROOT), "-B", "-j2")
    check_runtime()
    if main_config.read_bytes() != original or module.exists() or library.exists():
        raise RuntimeError("Configuration changed during the build. Nothing was activated; rerun setup.")
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + str(os.getpid())
    backup = main_config.with_name("hyprland.lua.cube-backup-" + stamp)
    shutil.copy2(main_config, backup)
    loaded = False
    wrote_library = False
    wrote_module = False
    wrote_config = False
    interrupted = None

    def remember_interrupt(signum, _frame):
        nonlocal interrupted
        interrupted = signum

    def check_interrupt():
        if interrupted is not None:
            raise KeyboardInterrupt

    # Defer signals to checkpoints so ownership flags are set before rollback.
    handlers = {sig: signal.signal(sig, remember_interrupt)
                for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    try:
        check_interrupt()
        library.parent.mkdir(parents=True, exist_ok=True)
        # Exclusive creation avoids overwriting a concurrent installation.
        with library.open("xb") as output:
            wrote_library = True
            output.write((ROOT / "build/omarchy-cube.so").read_bytes())
        library.chmod(0o755)
        check_interrupt()
        with module.open("x") as output:
            wrote_module = True
            output.write((ROOT / "examples/cube.lua").read_text())
            output.write("\n" + (ROOT / "shell/SettingsBridge.lua").read_text())
        # The user explicitly approved loading native code above. Config permission
        # is applied before load through the ordinary Lua module on reload.
        if main_config.read_bytes() != original:
            raise RuntimeError("Hyprland configuration changed before activation; refusing to overwrite it.")
        check_interrupt()
        wrote_config = True
        main_config.write_bytes(original + b'\n-- Omarchy Cube\nrequire("hypr.cube")\n')
        loaded = True  # reload may partially succeed, so rollback must attempt unload
        check_interrupt()
        run("hyprctl", "reload")
        check_interrupt()
        errors = run("hyprctl", "configerrors", capture=True)
        if errors:
            raise RuntimeError(errors)
        status = run("hyprctl", "omarchy-cube:status", capture=True)
        if not status.startswith("active="):
            raise RuntimeError("Native Cube did not report a healthy status: " + status)
        check_interrupt()
    except (Exception, KeyboardInterrupt):
        if wrote_config:
            shutil.copy2(backup, main_config)
            subprocess.run(["hyprctl", "reload"], check=False)
        if loaded:
            result = subprocess.run(["hyprctl", "plugin", "unload", str(library)], check=False)
            if result.returncode:
                print("Could not confirm unload. Keeping the library; log out before removing it.", file=sys.stderr)
            else:
                library.unlink(missing_ok=True)
        elif wrote_library:
            library.unlink(missing_ok=True)
        if wrote_module:
            module.unlink(missing_ok=True)
        raise
    finally:
        for sig, handler in handlers.items():
            signal.signal(sig, handler)
    print("\nCube is ready. Return to the widget and click Refresh.\n"
          "Super+Ctrl+Alt+Up opens the overview.\nBackup: " + str(backup))


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as error:
        print("Setup failed: " + str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("Setup interrupted.", file=sys.stderr)
        sys.exit(130)
    finally:
        if not sys.argv[1:] and sys.stdin.isatty() and os.environ.get("CUBE_SETUP_NO_PAUSE") != "1":
            try:
                input("\nPress Enter to close this terminal…")
            except (EOFError, KeyboardInterrupt):
                pass
